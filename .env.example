# Скопируй этот файл в .env и впиши свои данные. .env никому не отправляй.

# ---- Почта (IMAP) ----
# maimail.org: сервер mail.maimail.org, порт 993, SSL. Пароль тот же, что для входа в веб-почту.
# Сменишь почту: поменяй эти 4 строки (например Gmail: imap.gmail.com, 993, пароль приложения)
# и выполни python mail_to_telegram.py --mark-all, чтобы старые письма нового ящика не пришли разом.
# Если работает подстраховка через GitHub, обнови там секреты: gh secret set -f .env
IMAP_HOST=mail.maimail.org
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=you@maimail.org
IMAP_PASSWORD=PUT_YOUR_MAIL_PASSWORD_HERE

# Какие папки проверять, через запятую. Список имён: python mail_to_telegram.py --folders
IMAP_FOLDERS=INBOX

# ---- Telegram ----
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Твой chat_id: напиши боту /start, потом python mail_to_telegram.py --chat-id
TELEGRAM_CHAT_ID=

# ---- Поведение ----
# Как часто проверять почту, в секундах (не меньше 30)
POLL_SECONDS=60
# Сколько символов текста письма показывать в уведомлении
PREVIEW_CHARS=700
